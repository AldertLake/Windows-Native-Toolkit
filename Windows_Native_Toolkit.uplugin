{
	"FileVersion": 3,
	"Version": 5,
	"VersionName": "3.1.0",
	"FriendlyName": "Windows Native Toolkit",
	"Description": "Windows Native Toolkit exposes Blueprint and C++ access to native Windows audio, hardware, display, process, file, network, Bluetooth, dialog, notification, and config workflows for Unreal Engine projects on Win64.",
	"Category": "Windows Tools",
	"CreatedBy": "AldertLake",
	"CreatedByURL": "https://github.com/AldertLake",
	"DocsURL": "https://aldertlake-docs.vercel.app/docs/wnt",
	"MarketplaceURL": "https://www.fab.com/listings/db1cb6ed-ac7e-4408-a901-e45d6694cb0b",
	"SupportURL": "https://github.com/AldertLake/Windows-Native-Toolkit/issues",
	"CanContainContent": false,
	"Installed": true,
	"Modules": [
		{
			"Name": "EditorOnly",
			"Type": "Editor",
			"LoadingPhase": "PostEngineInit",
			"PlatformAllowList": [
				"Win64"
			]
		},
		{
			"Name": "SystemUtilityModule",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
				"Win64"
			]
		},
		{
			"Name": "NetworkUtilityModule",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
				"Win64"
			]
		},
		{
			"Name": "DeviceFrameworkModule",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
				"Win64"
			]
		},
		{
			"Name": "FileIOUtilityModule",
			"Type": "Runtime",
			"LoadingPhase": "Default",
			"PlatformAllowList": [
				"Win64"
			]
		}
	],
	"IsBetaVersion": false,
	"IsExperimentalVersion": false
}
